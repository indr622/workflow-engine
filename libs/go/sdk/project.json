{
  "name": "sdk-go",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/go/sdk",
  "tags": ["type:sdk", "lang:go"],
  "implicitDependencies": ["api-go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "!{projectRoot}/**/*_test.go", "goMod"],
      "options": { "command": "go build ./libs/go/sdk/...", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "goMod"],
      "options": { "command": "go test -cover ./libs/go/sdk/...", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "goMod", "{workspaceRoot}/.golangci.yml"],
      "options": { "command": "golangci-lint run ./libs/go/sdk/...", "cwd": "{workspaceRoot}" }
    }
  }
}
