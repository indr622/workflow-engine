{
  "name": "bpmn-go",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/go/bpmn",
  "tags": ["type:kernel", "lang:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "!{projectRoot}/**/*_test.go", "goMod"],
      "options": { "command": "go build ./libs/go/bpmn/...", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/testdata/**", "goMod"],
      "options": { "command": "go test ./libs/go/bpmn/...", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.go", "goMod", "{workspaceRoot}/.golangci.yml"],
      "options": { "command": "golangci-lint run ./libs/go/bpmn/...", "cwd": "{workspaceRoot}" }
    },
    "fuzz": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go test -run=^$ -fuzz=FuzzParse -fuzztime=${FUZZTIME:-60s} ./libs/go/bpmn",
        "cwd": "{workspaceRoot}"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "go test -run=^$ -bench=. -benchmem ./libs/go/bpmn", "cwd": "{workspaceRoot}" }
    }
  }
}
