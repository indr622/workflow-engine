# Salin ke .env lalu sesuaikan. File .env tidak di-commit.

# PostgreSQL (docker-compose dev). Port host 5433 agar tidak bentrok dengan Postgres lain di 5432.
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DB=workflow
POSTGRES_PORT=5433

# Engine
ENGINE_HTTP_ADDR=:8080
DATABASE_URL=postgres://workflow:workflow@localhost:5433/workflow?sslmode=disable
ENGINE_MIGRATE=true
ENGINE_LOG_LEVEL=info
ENGINE_CORS_ORIGINS=http://localhost:4200
ENGINE_MAX_RECORDS_PER_COMMAND=10000
ENGINE_MAX_VARIABLES_BYTES=1048576

# Pool dan timeout sesi Postgres. ENGINE_DB_MAX_CONNS=0 berarti max(4, 2*NumCPU).
# Kapasitas: replika x ENGINE_DB_MAX_CONNS + 10 <= max_connections Postgres (docs/ops/migrations.md).
ENGINE_DB_MAX_CONNS=0
ENGINE_DB_MIN_CONNS=2
ENGINE_DB_MAX_CONN_LIFETIME=30m
ENGINE_DB_MAX_CONN_IDLE_TIME=5m
ENGINE_DB_STATEMENT_TIMEOUT=10s
ENGINE_DB_LOCK_TIMEOUT=5s
ENGINE_DB_IDLE_IN_TX_TIMEOUT=15s

# Docker image (make docker-build / docker-push)
REGISTRY=ghcr.io/indr622/workflow-engine
# Fase 3: pemulihan saat start, relay outbox, janitor.
ENGINE_RECOVERY_ON_MISMATCH=fail
ENGINE_RECOVERY_DEEP_WINDOW=10m
ENGINE_RECOVERY_DEEP_SAMPLE=100
ENGINE_RECOVERY_TIMEOUT=10m
ENGINE_OUTBOX_POLL_INTERVAL=200ms
ENGINE_OUTBOX_BATCH_SIZE=100
ENGINE_OUTBOX_RETENTION=24h
ENGINE_OUTBOX_MAX_ATTEMPTS=10
ENGINE_SNAPSHOT_INTERVAL_RECORDS=5000
ENGINE_JANITOR_INTERVAL=1m
