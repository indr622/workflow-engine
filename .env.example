# Salin ke .env lalu sesuaikan. File .env tidak di-commit.

# PostgreSQL (docker-compose dev). Port host 5433 agar tidak bentrok dengan Postgres lain di 5432.
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DB=workflow
POSTGRES_PORT=5433

# Engine
ENGINE_HTTP_ADDR=:8080
DATABASE_URL=postgres://workflow:workflow@localhost:5433/workflow?sslmode=disable
ENGINE_MIGRATE=true
ENGINE_LOG_LEVEL=info
ENGINE_CORS_ORIGINS=http://localhost:4200

# Docker image (make docker-build / docker-push)
REGISTRY=ghcr.io/indr622/workflow-engine
