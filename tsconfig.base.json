{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@workflow/core": ["./libs/web/core/src/index.ts"],
      "@workflow/ui": ["./libs/web/ui/src/index.ts"],
      "@workflow/api-client": ["./libs/web/api-client/src/index.ts"],
      "@workflow/flow-canvas": ["./libs/web/flow-canvas/src/index.ts"],
      "@workflow/bpmn-viewer": ["./libs/web/bpmn-viewer/src/index.ts"],
      "@workflow/ui/*": ["./libs/web/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
